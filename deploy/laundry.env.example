# laundry configuration — single source of truth.
# Installed to /etc/laundry/laundry.env and loaded by systemd
# (EnvironmentFile). nginx workers inherit these (see the `env` lines in
# nginx.conf), so this one file configures both the gate and the server.

# --- Core -------------------------------------------------------------------
LAUNDRY_DB=/etc/laundry/laundry.db
# The keyed-hash pepper. Keep it OUT of the DB and readable only by the service.
LAUNDRY_SERVER_KEY_FILE=/etc/laundry/server.key

# --- Stealth ----------------------------------------------------------------
# Server header shown on every response. Bare "nginx" by default; set to a
# specific version (e.g. nginx/1.24.0) to match a real host if you prefer.
LAUNDRY_SERVER_HEADER=nginx

# --- Decoy (the site everyone sees) -----------------------------------------
# internal  -> serve local files from /var/www/decoy
# upstream  -> proxy to LAUNDRY_DECOY_TARGET (a remote or local URL)
LAUNDRY_DECOY_KIND=internal
LAUNDRY_DECOY_TARGET=

# --- Timing normalization ---------------------------------------------------
# Every request is padded to >= floor + random(0..jitter) ms so an authenticated
# lookup is indistinguishable from the decoy path by latency.
LAUNDRY_TIMING_FLOOR_MS=40
LAUNDRY_TIMING_JITTER_MS=15

# --- Cache / write timers ---------------------------------------------------
LAUNDRY_REFRESH_INTERVAL=5
LAUNDRY_FLUSH_INTERVAL=5
